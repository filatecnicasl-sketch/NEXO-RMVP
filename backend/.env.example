# ─── Plantilla de variables de entorno ──────────────────────────
# Copia este fichero como `.env` y rellena con tus valores reales.

# MongoDB local
MONGO_URL=mongodb://localhost:27017
DB_NAME=hemsa_local

# JWT — genera un secreto largo aleatorio
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Admin seed (se crea automáticamente al primer arranque)
ADMIN_EMAIL=admin@hemsa.es
ADMIN_PASSWORD=AdminHemsa2026!

# CORS
CORS_ORIGINS=http://localhost:3000

# Email IONOS SMTP (opcional)
IONOS_SMTP_HOST=smtp.ionos.es
IONOS_SMTP_PORT=465
IONOS_SMTP_USER=
IONOS_SMTP_PASSWORD=
IONOS_FROM_EMAIL=

# Emergent LLM Key (opcional — para OCR de PDFs)
# Obténla en https://app.emergent.sh → Perfil → Universal Key
EMERGENT_LLM_KEY=

# GDPR retention
GDPR_RETENTION_DAYS=30

# URL pública para enlaces en emails
APP_PUBLIC_URL=http://localhost:3000

# Storage app name
STORAGE_APP_NAME=hemsa-sf
